APP_NAME=画板
APP_ENV=development
APP_SECRET=change-me-use-at-least-32-random-characters
DATABASE_PATH=/data/forgeflow.db
REDIS_URL=redis://redis:6379/0
ARTIFACT_ROOT=/artifacts
ARTIFACT_INLINE_MAX_BYTES=120000
WEB_ORIGIN=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# Shared OpenAI-compatible fallback. Empty role API keys inherit this key.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# Agent1: requirement clarifier
AGENT1_LLM_PROVIDER=deepseek
AGENT1_LLM_BASE_URL=https://api.deepseek.com
AGENT1_LLM_MODEL=deepseek-v4-flash
AGENT1_LLM_API_KEY=

# Agent2: architect, architecture revision, and code review
AGENT2_LLM_PROVIDER=deepseek
AGENT2_LLM_BASE_URL=https://api.deepseek.com
AGENT2_LLM_MODEL=deepseek-v4-flash
AGENT2_LLM_API_KEY=

# Agent3: developer
AGENT3_LLM_PROVIDER=deepseek
AGENT3_LLM_BASE_URL=https://api.deepseek.com
AGENT3_LLM_MODEL=deepseek-v4-flash
AGENT3_LLM_API_KEY=

# Agent4: acceptance, incremental regression, and final acceptance
AGENT4_LLM_PROVIDER=deepseek
AGENT4_LLM_BASE_URL=https://api.deepseek.com
AGENT4_LLM_MODEL=deepseek-v4-flash
AGENT4_LLM_API_KEY=

RUN_LIVE_AI_TESTS=0
LIVE_AI_MAX_REQUESTS=20
REPOSITORY_AUTOMATION_ENABLED=0
# Host bind mounts. Empty HOST_SSH_DIR falls back to the host user's $HOME/.ssh.
HOST_WORKSPACE_ROOT=./data/workspaces
HOST_SSH_DIR=
WORKSPACE_ROOT=/workspaces
ALLOW_LOCAL_GIT=0
WORKSPACE_MAX_BYTES=10737418240
WORKSPACE_TTL_HOURS=72
SANDBOX_EXECUTOR_SOCKET=/runtime/sandbox.sock
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BASE_SECONDS=2
MAX_PARALLEL_REQUIREMENTS=2
GITHUB_APP_ID=
GITHUB_TOKEN=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
